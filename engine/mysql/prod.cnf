[mysqld]
# --------------------------
# PERFORMANCE OPTIMIZATION FOR MEDIAWIKI (10GB RAM)
# --------------------------

# Basic
user = mysql
skip-name-resolve = 1
sql_mode = STRICT_TRANS_TABLES,NO_ENGINE_SUBSTITUTION

# TEMPORARY — re-enables the mysql_native_password plugin, which MySQL 8.4
# disables by default. Needed only until every account has been moved to
# caching_sha2_password with bin/mysql_migrate_auth_caching_sha2.sh --apply.
# Remove this line and restart the db once that script reports "(none)" left.
mysql_native_password = ON

# --------------------------
# InnoDB SETTINGS
# --------------------------
innodb_buffer_pool_size = 8G
innodb_buffer_pool_instances = 4
# innodb_log_file_size is deprecated since 8.0.30 in favour of innodb_redo_log_capacity
innodb_redo_log_capacity = 2G
innodb_log_buffer_size = 256M
innodb_file_per_table = 1
innodb_flush_method = O_DIRECT
innodb_flush_log_at_trx_commit = 2
innodb_io_capacity = 2000
innodb_io_capacity_max = 4000

# --------------------------
# CONNECTIONS & THREADS
# --------------------------
max_connections = 200
thread_cache_size = 100
table_open_cache = 4000
open_files_limit = 20000

# --------------------------
# TEMP TABLES / MEMORY TABLES
# --------------------------
tmp_table_size = 256M
max_heap_table_size = 256M

# --------------------------
# QUERY CACHE
# --------------------------
# Removed: the query cache (query_cache_*) was dropped in MySQL 8.0 and the
# server refuses to start if these variables are set.

# --------------------------
# LOGGING & DIAGNOSTICS
# --------------------------
# slow_query_log = 1
# slow_query_log_file = /var/lib/mysql/slow.log
# long_query_time = 0.5
# log_queries_not_using_indexes = 1

# --------------------------
# PERFORMANCE SCHEMA
# --------------------------
# performance_schema = ON

# --------------------------
# CHARACTER SET (MediaWiki-friendly)
# --------------------------
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
